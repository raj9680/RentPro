@model RegisterRequest 
@{ 
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <aside class="auth-side">
        <a class="brand" href="../index.html"
            ><span class="brand-mark"
                ><svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <use href="../assets/icons/icons.svg#logo" /></svg></span
            ><span class="brand-name">StayNest</span></a
        >
        <div class="auth-side-copy">
            <h2>Beds, rooms and flats in one place.</h2>
            <p>See what is vacant, move people in, and know who has paid this month.</p>
            <div class="auth-preview" aria-hidden="true">
                <div class="card">
                    <div class="stat-label">Occupancy</div>
                    <div class="stat-value">77.3%</div>
                </div>
                <div class="card">
                    <div class="stat-label">Collected</div>
                    <div class="stat-value text-green">₹1.06L</div>
                </div>
                <div class="card">
                    <div class="stat-label">Vacant</div>
                    <div class="stat-value">4</div>
                </div>
            </div>
        </div>
        <p class="auth-foot">Template preview. Numbers are sample data.</p>
    </aside>
    <main class="auth-main">
        <form class="auth-card" asp-controller="Auth" asp-action="Register" method="post">
            <div>
                <h1>Create an owner account</h1>
                <p class="lead">Tenants do not sign up here. You add them when they move in.</p>
            </div>
            <div class="field">
                <label for="r-name">Full name</label>
                <input class="input" asp-for="FullName" />
                <span asp-validation-for="FullName" class="field-error">Enter your full name.</span>
            </div>

            <div class="field">
                <label for="r-email">Email</label>
                <input class="input" asp-for="Email" />
                <span asp-validation-for="Email" class="field-error">Enter a valid email.</span>
            </div>

            <div class="field">
                <label for="r-phone">Mobile number</label>
                <input class="input" asp-for="@Model.PhoneNumber" placeholder="10 digits" />
                <span class="field-error">Enter a 10-digit mobile number.</span>
            </div>

            <div class="field">
                <label for="l-pass">Password</label>
                <div class="input-group">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="../assets/icons/icons.svg#lock" /></svg>
                    <input class="input" id="l-pass" asp-for="Password" type="password" style="padding-right:44px">
                    <button type="button" class="btn-icon input-action" data-password-toggle="l-pass" aria-label="Show password"><span class="eye-on"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="../assets/icons/icons.svg#eye" /></svg></span><span class="eye-off hidden"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="../assets/icons/icons.svg#eye-off" /></svg></span></button>
                </div>
                <input type="hidden" asp-for="ConfirmPassword" value="Test@123" />
                <span class="field-error">Enter your password.</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Create account</button>

            <div class="auth-links">
                <span>Already have an account?</span>
                <a asp-controller="Auth" asp-action="Login">Log in</a>
            </div>

        </form>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
